// Perform diagonal traversal of a matrix.

#include <stdio.h>

int main()
{
    int a[100][100];
    int rows, columns, i, j, k;

    printf("Enter number of rows and columns: ");
    scanf("%d %d", &rows, &columns);

    printf("Enter matrix elements:\n");

    for (i = 0; i < rows; i++)
    {
        for (j = 0; j < columns; j++)
        {
            scanf("%d", &a[i][j]);
        }
    }

    printf("Diagonal traversal: ");

    for (k = 0; k < rows + columns - 1; k++)
    {
        if (k % 2 == 0)
        {
            for (i = k; i >= 0; i--)
            {
                j = k - i;

                if (i < rows && j < columns)
                {
                    printf("%d ", a[i][j]);
                }
            }
        }
        else
        {
            for (j = k; j >= 0; j--)
            {
                i = k - j;

                if (i < rows && j < columns)
                {
                    printf("%d ", a[i][j]);
                }
            }
        }
    }

    return 0;
}
